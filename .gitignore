# 浏览器 profile：含登录态 Cookie，绝不入库
farm/profiles/
profiles/

# 台账与运行状态（运营数据）
farm/state/
farm/farm.db
*.db
*.db-journal
*.db-wal
*.db-shm

# 依赖
node_modules/
**/node_modules/

# 日志与临时产物
*.log
logs/
tmp/
*.zip
*.pid

# 取数产物（first-fetch.sh 默认输出目录）
distribution/connectors/out/

# 选品引擎运行产物（engine/score.py 写 out/<run_id>/）
distribution/l3/platforms/*/out/

# Python 缓存（engine/ 随包分发）
**/__pycache__/
*.pyc

# 环境变量与密钥
.env
.env.*
!/.env.example

# macOS
.DS_Store
